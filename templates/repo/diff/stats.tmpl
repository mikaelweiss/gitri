{{/* Template Attributes:
* Addition: Number of additions
* Deletion: Number of deletions
* Classes: Additional classes for the root element
*/}}
{{if or .Addition .Deletion}}
<div class="flex-text-block tw-flex-shrink-0 diff-stats-summary {{if .Classes}}{{.Classes}}{{end}}">
	<span>
		{{if .Addition}}<strong class="tw-text-diff-added-fg" dir="ltr">+{{.Addition}}</strong>{{end}}
		{{if .Deletion}}<strong class="tw-text-diff-removed-fg" dir="ltr">-{{.Deletion}}</strong>{{end}}
	</span>
	{{$changes := Eval .Addition "+" .Deletion}}
	<span class="diff-stats-bar" data-tooltip-content="{{if ctx.Locale.HasOwnKey "repo.diff.stats_desc_file_summary"}}{{ctx.Locale.Tr "repo.diff.stats_desc_file_summary" (ctx.Locale.TrN $changes "repo.diff.num_changes_1" "repo.diff.num_changes_n" $changes) (ctx.Locale.TrN .Addition "repo.activity.git_stats_addition_1" "repo.activity.git_stats_addition_n" .Addition) (ctx.Locale.TrN .Deletion "repo.activity.git_stats_deletion_1" "repo.activity.git_stats_deletion_n" .Deletion)}}{{else}}{{ctx.Locale.Tr "repo.diff.stats_desc_file" $changes .Addition .Deletion}}{{end}}">
		{{/* if the denominator is zero, then the float result is "width: NaNpx", as before, it just works */}}
		<div class="diff-stats-add-bar" style="width: {{Eval 100 "*" .Addition "/" "(" .Addition "+" .Deletion "+" 0.0 ")"}}%"></div>
	</span>
</div>
{{end}}
